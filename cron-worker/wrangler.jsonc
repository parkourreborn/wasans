{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "wasans-trial-sweep",
	"main": "src/index.js",
	"compatibility_date": "2026-04-25",
	// Daily maintenance (trial sweep, expired-state cleanup), a per-minute
	// giveaway sweep, and the monthly WR compilation video (00:00 UTC on the
	// 1st) -- see src/index.js's scheduled() handler, which branches on
	// event.cron to tell them apart.
	"triggers": {
		"crons": ["0 6 * * *", "* * * * *", "0 0 1 * *"]
	}
}
