{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "wasans",
	"compatibility_date": "2026-04-25",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "wasans"
		},
		{
			// Video processing + WR compilations (video-worker/). Deploy that
			// Worker first.
			"binding": "VIDEO_SERVICE",
			"service": "wasans-video"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "wasans-opennext-cache"
		},
		{
			"binding": "SUBMISSION_VIDEOS",
			"bucket_name": "wasans",
			"remote": true
		},
		{
			// Private: players' direct uploads (incoming/) and the originals
			// kept for moderators (originals/). Never publicly served.
			"binding": "UPLOADS",
			"bucket_name": "wasans-uploads",
			"remote": true
		}
	],
	"queues": {
		"producers": [
			{
				// Consumed by the wasans-video Worker (video-worker/).
				"binding": "VIDEO_QUEUE",
				"queue": "video-processing"
			}
		]
		// No consumer for video-processing-dlq on purpose: this OpenNext
		// Worker has no queue() handler, and dead letters should stay in
		// that queue to be inspected. Stuck submissions are re-queued by the
		// daily maintenance sweep (see video-processing-service.ts).
	},
	"vpc_services": [
		{
			// The Discord bot (bot/), reached privately through the Raspberry
			// Pi's Cloudflare Tunnel instead of a public hostname. Create it
			// with `npx wrangler vpc service create wasans-bot --type http
			// --tunnel-id <tunnel id> --hostname bot --http-port 4500`
			// ("bot" is the bot's service name in bot/docker-compose.yml,
			// which the tunnel container resolves) and paste the service ID
			// it prints here.
			"binding": "BOT_SERVICE",
			"service_id": "01a11cbc-fc30-7a40-bdd1-5d0941829566",
			"remote": true
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"discordClientId": "1501043686828544121",
		"googleClientId": "185761022277-buat4302ug19v6f03e9limul0cil5s5d.apps.googleusercontent.com",
		// Roblox OAuth app (create.roblox.com > Credentials > OAuth 2.0 apps),
		// with redirect URI https://wasans.tully.sh/v2/auth/roblox/callback and
		// scopes openid + profile. The secret is `wrangler secret put
		// robloxClientSecret`. Until both are set, Roblox login/linking errors.
		"robloxClientId": "3505503195041831181",
		// For presigned direct-upload URLs (src/lib/server/r2-presign.ts),
		// signed with the R2_UPLOAD_ACCESS_KEY_ID/R2_UPLOAD_SECRET_ACCESS_KEY
		// secrets. Fill in the Cloudflare account ID (dashboard > R2 >
		// Account details).
		"R2_ACCOUNT_ID": "7599248988d1378ed7254d2fe7d3583d",
		"R2_UPLOADS_BUCKET": "wasans-uploads"
	},
	"d1_databases": [
		{
			"binding": "wasans",
			"database_name": "wasans",
			"database_id": "64fda1ee-ce43-4f8e-9e89-57fc8f695cc1",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "43bbb60d00184f3d90a64d69a894208d"
		}
	]
}
